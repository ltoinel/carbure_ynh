#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

_php_settings

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# Keep the woob virtualenv (rebuilt only when needed)
ynh_setup_source --dest_dir="$install_dir" --full_replace --keep="woob"
_carbure_layout
_woob_install

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_phpfpm
_nginx_http_add
ynh_config_add_nginx
_sync_add

#=================================================
# DATABASE AND BANK MODULES
#=================================================
ynh_script_progression "Applying the migrations of the database..."

ynh_exec_as_app "php$php_version" "$install_dir/tools/migrate.php"

_woob_update

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Upgrade of $app completed"
