#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# CHECKS
#=================================================

# Carbure's own rules for its administrator account
if [ ${#password} -lt 8 ]; then
    ynh_die "The password of the Carbure administrator must contain at least 8 characters"
fi
if ! [[ "$admin" =~ ^[A-Za-z0-9_.@-]{1,20}$ ]]; then
    ynh_die "The login of the Carbure administrator is limited to 20 letters, digits or _ . @ -: choose another YunoHost user"
fi

_php_settings

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"
_carbure_layout
_woob_install

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_phpfpm
_nginx_http_add
ynh_config_add_nginx
_sync_add

#=================================================
# INSTALL CARBURE
#=================================================
ynh_script_progression "Installing Carbure..."

admin_mail=$(ynh_user_get_info --username="$admin" --key=mail)

# A data directory kept from a previous install (removed without --purge) has a
# configuration pointing to the old database: set it aside
if [ -f "$data_dir/conf/prod.ini" ]; then
    old_config="$data_dir/conf/prod.ini.old-$(date +%Y%m%d%H%M%S)"
    mv "$data_dir/conf/prod.ini" "$old_config"
    ynh_print_warn "The configuration of an earlier installation was set aside in $old_config"
fi

# Command-line installer of Carbure: schema, starter data, administrator, configuration.
# Passwords are passed through the environment, not the command line
export CARBURE_DB_PASSWORD="$db_pwd"
export CARBURE_ADMIN_PASSWORD="$password"
sudo --preserve-env=CARBURE_DB_PASSWORD,CARBURE_ADMIN_PASSWORD -u "$app" \
    "php$php_version" "$install_dir/tools/install.php" \
        --db-host=localhost --db-name="$db_name" --db-user="$db_user" \
        --admin="$admin" --email="$admin_mail" --language="$language" --starter \
        --woob-path="$(woob_command)" --public-url="https://$domain"
unset CARBURE_DB_PASSWORD CARBURE_ADMIN_PASSWORD

chmod 600 "$data_dir/conf/prod.ini"

ynh_script_progression "Installing the bank modules of woob..."

_woob_update

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression "Installation of $app completed"
